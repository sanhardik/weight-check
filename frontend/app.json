{
  "expo": {
    "name": "SteelTrack",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.weightcheck.e45ony",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan weighment slips to record material weight",
        "NSPhotoLibraryUsageDescription": "Attach weighment slip photos from gallery",
        "NSPhotoLibraryAddUsageDescription": "Save weighment slip photos to gallery",
        "NSMicrophoneUsageDescription": "Dictate steel plate dimensions by voice"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF4500"
      },
      "package": "com.emergent.weightcheck.e45ony",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111111"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan weighment slips to record material weight"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach weighment slip photos from gallery"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dictate steel plate dimensions by voice"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
